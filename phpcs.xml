<?xml version="1.0"?>
<ruleset name="RealSatisfied Blocks">
    <description>WordPress Coding Standards for RealSatisfied Blocks plugin</description>

    <!-- Files to check -->
    <file>.</file>

    <!-- Exclude the vendor directory -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>logs/</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <!-- How to scan -->
    <arg value="sp"/> <!-- Show sniff and progress -->
    <arg name="basepath" value="./"/><!-- Strip the file paths down to the relevant bit -->
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/><!-- Enables parallel processing when available for faster results -->

    <!-- Rules: WordPress Coding Standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <config name="minimum_supported_wp_version" value="5.4"/>

    <!-- Exclude some rules that might be too strict for this plugin -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>*/includes/class-*.php</exclude-pattern>
    </rule>

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>

    <!-- Don't flag closing PHP tags in template files -->
    <rule ref="PSR2.Files.ClosingTag.NotAllowed">
        <exclude-pattern>*/templates/*</exclude-pattern>
    </rule>
</ruleset>