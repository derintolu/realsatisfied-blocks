<?xml version="1.0"?>
<ruleset name="RealSatisfied Blocks - Deploy">
    <description>Minimal WordPress standards for deployment</description>

    <!-- Files to check -->
    <file>.</file>

    <!-- Exclude vendor and development files -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>logs/</exclude-pattern>
    <exclude-pattern>tests/</exclude-pattern>
    <exclude-pattern>*.md</exclude-pattern>

    <!-- Basic scanning -->
    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Only check for critical security issues -->
    <rule ref="WordPress.Security.EscapeOutput">
        <!-- Allow template variables that are already escaped -->
        <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
    </rule>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <!-- Basic PHP syntax -->
    <rule ref="Generic.PHP.Syntax"/>

    <!-- Ignore most formatting rules -->
    <config name="minimum_supported_wp_version" value="5.4"/>
</ruleset>