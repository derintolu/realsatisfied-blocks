# Production Deployment Configuration
# Copy this file to .env and fill in your production values
# DO NOT commit .env file to version control

# FTP Deployment (Optional)
FTP_SERVER=your-ftp-server.com
FTP_USERNAME=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_SERVER_DIR=/public_html

# SSH Deployment (Recommended)
SSH_HOST=your-server-ip-or-domain.com
SSH_USERNAME=your-ssh-username
SSH_KEY=your-private-ssh-key
SSH_PORT=22
DEPLOY_PATH=/var/www/html/your-site

# GitHub Secrets to Configure:
# - FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, FTP_SERVER_DIR (for FTP deployment)
# - SSH_HOST, SSH_USERNAME, SSH_KEY, SSH_PORT, DEPLOY_PATH (for SSH deployment)
# - DEPLOY_DOWNLOAD_URL (optional, for custom download URL)