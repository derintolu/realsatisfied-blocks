{
    "name": "derintolu/realsatisfied-blocks",
    "description": "Standalone Gutenberg blocks for RealSatisfied office and agent data",
    "type": "wordpress-plugin",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.5",
        "wp-coding-standards/wpcs": "^2.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7"
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress .",
        "lint-fix": "phpcbf --standard=WordPress .",
        "post-install-cmd": [
            "@install-standards"
        ],
        "post-update-cmd": [
            "@install-standards"
        ],
        "install-standards": [
            "vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcompatibility/php-compatibility"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}